# Copy to `.env` or `.env.local` in this folder (`apps/medusa-backend`).
# `server.js` and `medusa-config.js` load both via dotenv.
#
# Anything marked REQUIRED-PROD must be set before deploying to production.
# Server will exit on startup if these are missing.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# REQUIRED-PROD. Local dev default fallback is postgres://postgres:postgres@localhost:5432/medusa
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa

# ── Auth secrets ──────────────────────────────────────────────────────────────
# REQUIRED-PROD. Must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# JWT_SECRET — used by Medusa core for any framework-level tokens.
# SELLER_JWT_SECRET / CUSTOMER_JWT_SECRET — used by the custom backend in server.js for
# seller and customer auth. They fall back to JWT_SECRET if not set individually, but
# using distinct secrets per audience is recommended (blast-radius reduction).
# COOKIE_SECRET — used by Medusa core for signed cookies.
#
# IMPORTANT: The previously hardcoded fallback values were committed to a public repo and
# are considered compromised. Rotate to fresh values before any production deploy.
# JWT_SECRET=
# SELLER_JWT_SECRET=
# CUSTOMER_JWT_SECRET=
# COOKIE_SECRET=

# ── TOTP encryption key (2FA at-rest encryption) ──────────────────────────────
# REQUIRED-PROD. Exactly 64 hex chars (= 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In dev (NODE_ENV != production) the server falls back to a placeholder and warns.
# TOTP_ENCRYPTION_KEY=

# ── Superuser bootstrap ───────────────────────────────────────────────────────
# Comma-separated list of emails that get superuser role on first registration.
# Default if unset: murathan.cotuk@gmail.com (see server.js).
# SUPERUSER_EMAILS=you@example.com,partner@example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Required in production. Comma-separated list of frontend origins (https://...).
# If unset in production, ALL cross-origin requests are blocked.
# CORS_ORIGINS=https://andertal.com,https://www.andertal.com,https://sellercentral.andertal.com
# STORE_CORS=http://localhost:3000
# ADMIN_CORS=http://localhost:3002
# AUTH_CORS=http://localhost:3000,http://localhost:3002

# ── Shop URL for Flow emails ──────────────────────────────────────────────────
# Must be absolute HTTPS URL (no trailing slash). Render backend does not inherit
# Vercel env automatically — set this here explicitly.
# Aliases also read: SHOP_PUBLIC_URL, PUBLIC_SHOP_URL, NEXT_PUBLIC_SITE_URL, SITE_URL.
# STOREFRONT_PUBLIC_URL=https://www.andertal.com

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Used by flow-queue worker and rate limiting. Falls back to in-memory if unset.
# REDIS_URL=redis://localhost:6379

# ── DeepL — automatic translation ─────────────────────────────────────────────
# Create a key: https://www.deepl.com/pro-api
# Free API keys typically end with `:fx`; the backend then uses api-free.deepl.com unless overridden.
DEEPL_AUTH_KEY=
# Optional. Default: https://api.deepl.com/v2/translate (Pro) or https://api-free.deepl.com/v2/translate (free key).
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# ── Sentry (optional but recommended in production) ───────────────────────────
# Create a Node.js project at https://sentry.io and paste the DSN here.
# When unset, Sentry init is a no-op — server runs normally, no events sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1   # 0.0 disables tracing, 1.0 traces every request
