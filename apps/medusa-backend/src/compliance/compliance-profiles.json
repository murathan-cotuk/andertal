    "best_before": { "type": "text", "label_i18n": { "de": "Mindesthaltbarkeit", "en": "Best before", "tr": "Son kullanma" }, "validation_regex": null, "help_text_i18n": {} },
    "nutrition_values": { "type": "text", "label_i18n": { "de": "Nährwerte", "en": "Nutrition values", "tr": "Besin değerleri" }, "validation_regex": null, "help_text_i18n": {} },
    "daily_dose": { "type": "text", "label_i18n": { "de": "Tagesdosis", "en": "Daily dose", "tr": "Günlük doz" }, "validation_regex": null, "help_text_i18n": {} },
    "warning_text": { "type": "text", "label_i18n": { "de": "Warnhinweis", "en": "Warning text", "tr": "Uyarı metni" }, "validation_regex": null, "help_text_i18n": {} },
    "age_warning": { "type": "text", "label_i18n": { "de": "Altersempfehlung", "en": "Age warning", "tr": "Yaş uyarısı" }, "validation_regex": null, "help_text_i18n": {} },
    "fiber_composition": { "type": "text", "label_i18n": { "de": "Faserzusammensetzung", "en": "Fiber composition", "tr": "Elyaf kompozisyonu" }, "validation_regex": null, "help_text_i18n": {} },
    "care_symbols": { "type": "text", "label_i18n": { "de": "Pflegesymbole", "en": "Care symbols", "tr": "Bakım sembolleri" }, "validation_regex": null, "help_text_i18n": {} },
