# Medusa Backend URL — sellercentral API çağrıları (POST /admin-hub/v1/pages vb.)
# apps/shop ile aynı URL olmalı; aksi halde landing / menü bir app’te kayıtlı diğerinde boş kalır.
#
# Yerel Medusa çalıştırıyorsan:
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
#
# .env.local yoksa veya boşsa kod şu production adresini kullanır:
# https://api.andertal.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.andertal.com

# ── Dev-only: extra backend origins allowed by the Content-Security-Policy ──
# Comma-separated list. Only applied in development (NODE_ENV != production).
# In production the CSP allows only 'self' https: wss:, so LAN IPs from this
# list never leak into a production deploy. Default if unset:
# "http://localhost:9000". Add your LAN IP for cross-device testing:
# SC_ALLOWED_DEV_BACKEND_HOSTS=http://localhost:9000,http://192.168.2.127:9000

# DeepL (Flow “Translate to other languages”) is configured on the Medusa backend only:
# apps/medusa-backend/.env → DEEPL_AUTH_KEY (see apps/medusa-backend/.env.example).

# ── Auth — required for middleware JWT verification ───────────────────────────
# Must match the backend value. The middleware verifies seller tokens (sc_token
# cookie) using HS256 + this secret. If unset in production, ALL authenticated
# requests redirect to login.
#
# Set this to the same value used by the backend (apps/medusa-backend) for
# SELLER_JWT_SECRET (falls back to JWT_SECRET on the backend, so either works
# as long as both apps use the same value).
#
# Generate (only when starting fresh — otherwise copy the backend's value):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SELLER_JWT_SECRET=
# JWT_SECRET=

# ── Sentry (optional but recommended in production) ───────────────────────────
# Create a Next.js project at https://sentry.io. NEXT_PUBLIC_SENTRY_DSN is
# included in the client bundle (DSNs are public-by-design). When unset,
# Sentry init becomes a no-op — app runs normally, no events sent.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=                                       # optional — falls back to NEXT_PUBLIC_SENTRY_DSN on server
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=murathan-cotuk                         # for source map upload at build time
# SENTRY_PROJECT_SELLERCENTRAL=andertal-sellercentral
# SENTRY_AUTH_TOKEN=                                # required only for source map upload (in CI)
