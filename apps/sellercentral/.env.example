# Medusa Backend URL — sellercentral API çağrıları (POST /admin-hub/v1/pages vb.)
# apps/shop ile aynı URL olmalı; aksi halde landing / menü bir app’te kayıtlı diğerinde boş kalır.
#
# Yerel Medusa çalıştırıyorsan:
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
#
# .env.local yoksa veya boşsa kod şu production adresini kullanır:
# https://api.andertal.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.andertal.com

# DeepL (Flow “Translate to other languages”) is configured on the Medusa backend only:
# apps/medusa-backend/.env → DEEPL_AUTH_KEY (see apps/medusa-backend/.env.example).

# ── Auth — required for middleware JWT verification ───────────────────────────
# Must match the backend value. The middleware verifies seller tokens (sc_token
# cookie) using HS256 + this secret. If unset in production, ALL authenticated
# requests redirect to login.
#
# Set this to the same value used by the backend (apps/medusa-backend) for
# SELLER_JWT_SECRET (falls back to JWT_SECRET on the backend, so either works
# as long as both apps use the same value).
#
# Generate (only when starting fresh — otherwise copy the backend's value):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SELLER_JWT_SECRET=
# JWT_SECRET=
