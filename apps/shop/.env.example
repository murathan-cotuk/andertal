# ─────────────────────────────────────────────────────────────────────────────
# YEREL GELİŞTİRME — Shop’ta sidebar kategorileri / menüler için VERİ görünmüyorsa
# ─────────────────────────────────────────────────────────────────────────────
# Shop, Next tarafından bu API’leri proxy eder: /api/store-categories → {BACKEND}/store/categories
# Backend’a ulaşılamazsa liste SESSİZE boş döner (UI boş görünür). Önce bunları doğrula:
#
#   1) apps/medusa-backend çalışsın ve dinlesin (çoğu kurulum: http://localhost:9000)
#   2) Bu dosyayı .env.local olarak kopyalayın; production URL’si bağlı kaldıysa yerel DB’yi görmezsiniz
#   3) Terminalde (shop dev çalışırken) şu uyarıları arayın:
#      [shop/api/store-categories] … ECONNREFUSED veya 5xx
#
# Yerel Medusa’ya bağlanmak (önerilen):
#   NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
#   # veya bu satırı tamamen kaldırın — varsayılan zaten http://localhost:9000
#
# Tarayıcıda localhost açıkken ENV’deki uzak URL’yi kullanmak İSTEMİYORSAN (login + API tutarlılığı):
#   NEXT_PUBLIC_MEDUSA_USE_ENV_IN_DEV=false
#   # böylece client tarafı da varsayılan localhost:9000’e gider (medusa-client).
#
# Canlı backend’i localhost shop’tan görmek (aynı prod DB):
#   NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.andertal.com
#   NEXT_PUBLIC_MEDUSA_USE_ENV_IN_DEV=true
# ─────────────────────────────────────────────────────────────────────────────
# Telefon / LAN: http://192.168.x.x:3000 Shop açılıyorsa Next 16 bazen `/_next` isteklerini engeller.
# Virgülle birden fazla origin: http://192.168.1.5:3000,http://10.0.0.2:3000
# SHOP_ALLOWED_DEV_ORIGINS=http://192.168.x.x:3000
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.andertal.com

# Trustpilot Invitation JS (Integrationen → JavaScript — tp.register Schlüssel). Leer lassen = nicht laden.
# NEXT_PUBLIC_TRUSTPILOT_INVITE_REGISTER_KEY=

NEXT_PUBLIC_MEDUSA_USE_ENV_IN_DEV=false
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=5000

# ─── Production / Vercel (örnek — .env.local ile karıştırma) ───────────────
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.andertal.com
# NEXT_PUBLIC_MEDUSA_USE_ENV_IN_DEV=true

# Tarayıcı sekmesi / OG başlığında "Site adı | …" için (opsiyonel; yoksa SITE_URL host veya Andertal)
# NEXT_PUBLIC_SITE_NAME=Andertal

# Seller Central URL (Footer vb. satıcı girişi linki)
NEXT_PUBLIC_SELLERCENTRAL_URL=https://sellercentral.andertal.com

# Stripe (checkout için)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Algolia (ürün arama dropdown için - opsiyonel)
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
# NEXT_PUBLIC_ALGOLIA_INDEX_PRODUCTS=
