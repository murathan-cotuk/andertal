# Proje kökü örnek ortam değişkenleri.
# Gerçek değerleri .env.local içine koyun (o dosya .gitignore'ludur, repoya girmez).

# ── Telegram ↔ Claude köprüsü (telegram_listener.js) ──────────────────────
# GÜVENLİK: Bu köprü, Telegram'dan gelen mesajı insan onayı olmadan
# Read/Edit/Bash yetkileriyle çalıştırır (uzaktan kod çalıştırma). Sadece
# kendi güvendiğiniz makinede kullanın. Token'ı asla repoya commit'lemeyin.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id

# Opsiyonel köprü ayarları:
# CLAUDE_BIN=claude            # claude CLI çalıştırılabilir adı/yolu (Windows: claude.cmd)
# CLAUDE_WORKDIR=.             # Claude'un çalışacağı dizin (varsayılan: proje kökü)
# CLAUDE_TIMEOUT_MS=600000     # Tek işin zaman aşımı (ms), varsayılan 10 dk
